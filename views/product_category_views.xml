<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit dari view account (jika ada) -->
    <record id="view_category_property_form_inherit_swa_acc" model="ir.ui.view">
        <field name="name">product.category.property.form.inherit.swa_acc.mrp.account</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form"/>
        <field name="arch" type="xml">
            <group name="account_property" position="inside">
                <group string="SWA" name="swa">
                    <field name="swa_short_code"/>
                </group>
            </group>
        </field>
    </record>

    <record id="view_category_tree_inherit_swa_acc" model="ir.ui.view">
        <field name="name">product.category.tree.inherit.swa_acc</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="swa_short_code"/>
            </field>
        </field>
    </record>

</odoo>
   
     
    