<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         FOH Mapping Item - List View
    ============================================================ -->
    <record id="view_az_mapping_item_foh_list" model="ir.ui.view">
        <field name="name">az.mapping.item.foh.list</field>
        <field name="model">az.mapping.item.foh</field>
        <field name="arch" type="xml">
            <list string="FOH Mapping Item">
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         FOH Mapping Item - Form View
    ============================================================ -->
    <record id="view_az_mapping_item_foh_form" model="ir.ui.view">
        <field name="name">az.mapping.item.foh.form</field>
        <field name="model">az.mapping.item.foh</field>
        <field name="arch" type="xml">
            <form string="FOH Mapping Item">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="product_name"/>
                        <field name="type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         FOH Mapping Item - Search View
    ============================================================ -->
    <record id="view_az_mapping_item_foh_search" model="ir.ui.view">
        <field name="name">az.mapping.item.foh.search</field>
        <field name="model">az.mapping.item.foh</field>
        <field name="arch" type="xml">
            <search string="FOH Mapping Item">
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="type"/>
                <filter string="None"         name="filter_none"         domain="[('type','=','none')]"/>
                <filter string="Electricity"  name="filter_electricity"  domain="[('type','=','electricity')]"/>
                <filter string="Wage"         name="filter_wage"         domain="[('type','=','wage')]"/>
                <filter string="Overtime"     name="filter_overtime"     domain="[('type','=','overtime')]"/>
                <filter string="Others"       name="filter_others"       domain="[('type','=','others')]"/>
                <filter string="Sparepart"    name="filter_sparepart"    domain="[('type','=','sparepart')]"/>
                <filter string="Fuel"         name="filter_fuel"         domain="[('type','=','fuel')]"/>
                <filter string="Depreciation" name="filter_depreciation" domain="[('type','=','depreciation')]"/>
                <filter string="WorkOrder"    name="filter_work_order"   domain="[('type','=','work_order')]"/>
                <filter string="Packing"      name="filter_packing"      domain="[('type','=','packing')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         FOH Mapping Item - Action
    ============================================================ -->
    <record id="action_az_mapping_item_foh" model="ir.actions.act_window">
        <field name="name">FOH Mapping Item</field>
        <field name="res_model">az.mapping.item.foh</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_az_mapping_item_foh_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first FOH Mapping Item
            </p>
            <p>Define product mappings for Factory Overhead (FOH) cost types.</p>
        </field>
    </record>

    <!-- ============================================================
         Menu: Accounting > Configuration > User Defined > FOH > FOH Mapping Item
         (parent menu_accounting_config_foh already defined in az_mapping_account_foh_views.xml)
    ============================================================ -->
    <menuitem id="menu_az_mapping_item_foh"
              name="FOH Mapping Item"
              parent="swa_acc.menu_accounting_config_foh"
              action="action_az_mapping_item_foh"
              sequence="20"/>

</odoo>
