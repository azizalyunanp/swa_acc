<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_item_staging_list" model="ir.ui.view">
            <field name="name">swa.item.staging.list</field>
            <field name="model">swa.item.staging</field>
            <field name="arch" type="xml">
                <list string="Item Staging" create="false" edit="false" delete="false">
                    <field name="item_id"/>
                    <field name="item_name"/>
                    <field name="unit_id"/>
                    <field name="type_item"/>
                    <field name="is_executed" widget="badge" decoration-success="is_executed == 'Yes'" decoration-info="is_executed == 'No'"/>
                </list>
            </field>
        </record>

        <record id="view_item_staging_form" model="ir.ui.view">
            <field name="name">swa.item.staging.form</field>
            <field name="model">swa.item.staging</field>
            <field name="arch" type="xml">
                <form string="Item Staging">
                    <sheet>
                        <group>
                            <group>
                                <field name="item_id"/>
                                <field name="item_name"/>
                            </group>
                            <group>
                                <field name="unit_id"/>
                                <field name="type_item"/>
                                <field name="is_executed"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_item_staging_search" model="ir.ui.view">
            <field name="name">swa.item.staging.search</field>
            <field name="model">swa.item.staging</field>
            <field name="arch" type="xml">
                <search string="Item Staging">
                    <field name="item_id"/>
                    <field name="item_name"/>
                    <separator/>
                    <filter string="Not Executed" name="not_executed" domain="[('is_executed', '=', 'No')]"/>
                    <filter string="Executed" name="executed" domain="[('is_executed', '=', 'Yes')]"/>
                </search>
            </field>
        </record>

        <record id="action_item_staging" model="ir.actions.act_window">
            <field name="name">Item Staging</field>
            <field name="res_model">swa.item.staging</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_item_staging_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No Item staging data</p>
                <p>Staging data for Items imported from AX 2012.</p>
            </field>
        </record>

        <menuitem id="swa_acc.menu_staging_data"
                  name="Staging Data"
                  parent="swa_acc.menu_synchronize_root"
                  sequence="20"
                  groups="account.group_account_user"/>

        <menuitem id="menu_item_staging"
                  name="Item Staging"
                  parent="swa_acc.menu_staging_data"
                  action="action_item_staging"
                  sequence="10"/>
    </data>
</odoo>
