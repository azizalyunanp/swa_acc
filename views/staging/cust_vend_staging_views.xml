<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cust_vend_staging_list" model="ir.ui.view">
            <field name="name">swa.cust.vend.staging.list</field>
            <field name="model">swa.cust.vend.staging</field>
            <field name="arch" type="xml">
                <list string="Cust/Vend Staging" create="false" edit="false" delete="false">
                    <field name="cust_vend_id"/>
                    <field name="name"/>
                    <field name="type_cust_vend"/>
                    <field name="is_executed" widget="badge" decoration-success="is_executed == 'Yes'" decoration-info="is_executed == 'No'"/>
                </list>
            </field>
        </record>

        <record id="view_cust_vend_staging_form" model="ir.ui.view">
            <field name="name">swa.cust.vend.staging.form</field>
            <field name="model">swa.cust.vend.staging</field>
            <field name="arch" type="xml">
                <form string="Cust/Vend Staging">
                    <sheet>
                        <group>
                            <group>
                                <field name="cust_vend_id"/>
                                <field name="name"/>
                                <field name="type_cust_vend"/>
                            </group>
                            <group>
                                <field name="address"/>
                                <field name="address_ext"/>
                                <field name="is_executed"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cust_vend_staging_search" model="ir.ui.view">
            <field name="name">swa.cust.vend.staging.search</field>
            <field name="model">swa.cust.vend.staging</field>
            <field name="arch" type="xml">
                <search string="Cust/Vend Staging">
                    <field name="cust_vend_id"/>
                    <field name="name"/>
                    <separator/>
                    <filter string="Not Executed" name="not_executed" domain="[('is_executed', '=', 'No')]"/>
                    <filter string="Executed" name="executed" domain="[('is_executed', '=', 'Yes')]"/>
                    <separator/>
                    <filter string="Customer" name="customer" domain="[('type_cust_vend', '=', 'Customer')]"/>
                    <filter string="Vendor" name="vendor" domain="[('type_cust_vend', '=', 'Vendor')]"/>
                </search>
            </field>
        </record>

        <record id="action_cust_vend_staging" model="ir.actions.act_window">
            <field name="name">Cust/Vend Staging</field>
            <field name="res_model">swa.cust.vend.staging</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_cust_vend_staging_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No Cust/Vend staging data</p>
                <p>Staging data for Customers and Vendors imported from AX 2012.</p>
            </field>
        </record>

        <menuitem id="menu_cust_vend_staging"
                  name="Cust/Vend Staging"
                  parent="swa_acc.menu_staging_data"
                  action="action_cust_vend_staging"
                  sequence="10"/>
    </data>
</odoo>
