<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         FOH Item Cost Price - List View
    ============================================================ -->
    <record id="view_az_foh_item_cost_price_list" model="ir.ui.view">
        <field name="name">az.foh.item.cost.price.list</field>
        <field name="model">az.foh.item.cost.price</field>
        <field name="arch" type="xml">
            <list string="FOH Item Cost Price" js_class="foh_item_cost_price_list">
                <field name="trans_date"/>
                <field name="location_id"/>
                <field name="company_id"/>
                <field name="default_code"/>
                <field name="product_name"/>
                <field name="product_id_foh"/>
                <field name="uom_id"/>
                <field name="currency_id"/>
                <field name="amount" digits="[16,2]"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         FOH Item Cost Price - Form View
    ============================================================ -->
    <record id="view_az_foh_item_cost_price_form" model="ir.ui.view">
        <field name="name">az.foh.item.cost.price.form</field>
        <field name="model">az.foh.item.cost.price</field>
        <field name="arch" type="xml">
            <form string="FOH Item Cost Price">
                <sheet>
                    <group>
                        <group string="Reference">
                            <field name="trans_date"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Product">
                            <field name="product_id"/>
                            <field name="product_name"/>
                            <field name="product_id_foh"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cost">
                            <field name="uom_id"/>
                            <field name="currency_id"/>
                            <field name="amount" digits="[16,2]"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         FOH Item Cost Price - Search View
    ============================================================ -->
    <record id="view_az_foh_item_cost_price_search" model="ir.ui.view">
        <field name="name">az.foh.item.cost.price.search</field>
        <field name="model">az.foh.item.cost.price</field>
        <field name="arch" type="xml">
            <search string="FOH Item Cost Price">
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="product_id_foh"/>
                <field name="location_id"/>
                <field name="trans_date"/>
                <filter name="my_company"
                        string="My Company"
                        domain="[('company_id', 'in', allowed_company_ids)]"
                        invisible="1"/>
                <filter string="This Month" name="this_month"
                        domain="[('trans_date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('trans_date','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="FOH Item" name="group_foh_item" context="{'group_by': 'product_id_foh'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Trans Date" name="group_date" context="{'group_by': 'trans_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         FOH Item Cost Price - Wizard Form View
    ============================================================ -->
    <record id="view_az_foh_item_cost_price_wizard_form" model="ir.ui.view">
        <field name="name">az.foh.item.cost.price.wizard.form</field>
        <field name="model">az.foh.item.cost.price.wizard</field>
        <field name="arch" type="xml">
            <form string="FOH Item Cost Price">
                <group>
                    <group string="Period">
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <group string="Parameters">
                        <field name="company_id"/>
                        <field name="location_id"/>
                    </group>
                </group>
                <footer>
                    <button name="calc_foh_item_cost_price"
                            type="object"
                            string="Calculate"
                            class="btn-primary"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================
         FOH Item Cost Price - Wizard Action
    ============================================================ -->
    <record id="action_az_foh_item_cost_price_wizard" model="ir.actions.act_window">
        <field name="name">FOH Item Cost Price</field>
        <field name="res_model">az.foh.item.cost.price.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_az_foh_item_cost_price_wizard_form"/>
    </record>

    <!-- ============================================================
         FOH Item Cost Price - Main Action
    ============================================================ -->
    <record id="action_az_foh_item_cost_price" model="ir.actions.act_window">
        <field name="name">FOH Item Cost Price</field>
        <field name="res_model">az.foh.item.cost.price</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_company': 1}</field>
        <field name="search_view_id" ref="view_az_foh_item_cost_price_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No FOH Item Cost Price records yet.
            </p>
            <p>Run the FOH Item Cost Price wizard to generate records.</p>
        </field>
    </record>

    <!-- ============================================================
         Menu: Accounting > Configuration > User Defined > FOH > FOH Item Cost Price
    ============================================================ -->
    <menuitem id="menu_az_foh_item_cost_price"
              name="FOH Item Cost Price"
              parent="swa_acc.menu_accounting_config_foh"
              action="action_az_foh_item_cost_price"
              sequence="50"/>

</odoo>
